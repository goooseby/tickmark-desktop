{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tickmark",
  "mainBinaryName": "tickmark-desktop",
  "version": "0.1.0",
  "identifier": "io.github.goooseby.tickmark.desktop",
  "build": { "frontendDist": "../web" },
  "app": {
    "windows": [{ "label": "main", "title": "Tickmark", "width": 1200, "height": 800, "minWidth": 770, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost" },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
