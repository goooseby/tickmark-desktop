{
  "manifest_version": 3,
  "name": "Tickmark 网页计时",
  "version": "0.1.0",
  "description": "把 Edge 前台标签页的域名和视频播放状态交给本机 Tickmark 采集器。",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "incognito": "not_allowed",
  "background": { "service_worker": "background.js", "type": "module" }
}
